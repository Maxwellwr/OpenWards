<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    The version. Builds are development builds ("0.1.0-dev", which never look for updates) unless the release
    workflow builds with OpenWardsRelease=true. Bump VersionPrefix for each release; the tag is v$(VersionPrefix).
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(OpenWardsRelease)' != 'true'">dev</VersionSuffix>
    <Product>OpenWards</Product>
    <Company>OpenWards</Company>
    <Copyright>Copyright (c) 2026 Maksim Maslich and the CorsixTH contributors</Copyright>
  </PropertyGroup>

  <!--
    Projects whose code runs inside the lockstep simulation set
    OpenWardsDeterministic=true. The determinism analyzer is attached to
    them in Directory.Build.targets.
  -->
  <PropertyGroup>
    <OpenWardsDeterministic Condition="'$(OpenWardsDeterministic)' == ''">false</OpenWardsDeterministic>
  </PropertyGroup>
</Project>
